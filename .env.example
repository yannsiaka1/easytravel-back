APP_NAME=EasyTravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# Développement local : SQLite fonctionne sans configuration supplémentaire.
DB_CONNECTION=sqlite
# DB_DATABASE=/absolute/path/to/database/database.sqlite

# Production Railway : installer le pilote PostgreSQL avec
# RAILPACK_PHP_EXTENSIONS=pdo_pgsql
# puis définir DB_CONNECTION=pgsql et DB_URL avec la variable
# DATABASE_URL du service PostgreSQL Railway.
# DB_CONNECTION=pgsql
# DB_URL=postgresql://user:password@host:port/database

SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@easytravel.local"
MAIL_FROM_NAME="${APP_NAME}"

# Provisionnement optionnel du premier agent en production
EASYTRAVEL_AGENT_EMAIL=
EASYTRAVEL_AGENT_PASSWORD=
EASYTRAVEL_AGENT_NOM=
EASYTRAVEL_AGENT_PRENOM=
EASYTRAVEL_AGENT_CNI=
EASYTRAVEL_AGENT_TELEPHONE=
